# Copy to .env and edit if needed.

# Where Ollama is listening
OLLAMA_HOST=http://127.0.0.1:11434

# Model pulled with: ollama pull qwen2.5:3b-instruct
JARVIS_MODEL=qwen2.5:3b-instruct

# What it calls itself
JARVIS_NAME=Jarvis

# What it calls you
OPERATOR_NAME=sir

# Server bind address. 0.0.0.0 so your phone can reach it over Tailscale.
HOST=0.0.0.0
PORT=8200

# How many past turns to keep in context
HISTORY_TURNS=12

# Whisper model size for speech-to-text (CPU only on this machine)
JARVIS_STT_MODEL=small.en

# Path to the Piper voice model (.onnx). The matching .onnx.json must be
# in the same folder. See README, Phase 2, for the free download command.
JARVIS_TTS_MODEL=./models/en_US-lessac-medium.onnx
